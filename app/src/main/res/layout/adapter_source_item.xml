<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingStart="24dp"
    android:paddingEnd="0dp">

    <View
        android:id="@+id/health"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/shape_dot" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:focusable="true"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:focusable="true"
        android:paddingHorizontal="6dp"
        android:paddingVertical="8dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/used"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/shape_dialog_glass_input"
        android:padding="4dp"
        android:text="@string/source_in_use"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:background="@drawable/selector_dialog_glass_chip"
        android:focusable="true"
        android:text="@string/source_delete"
        android:textColor="@color/white"
        android:textSize="14sp" />

</LinearLayout>
