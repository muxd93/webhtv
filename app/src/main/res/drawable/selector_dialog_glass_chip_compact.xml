<?xml version="1.0" encoding="utf-8"?>
<!-- 紧凑版玻璃 chip（QA2）：源管理弹窗行内小按钮专用，水平 padding 由 14dp 收窄到 6dp，为行文字让宽 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#38363A70" />
            <stroke android:width="1dp" android:color="#1F9B9FD0" />
            <padding android:left="6dp" android:top="8dp" android:right="6dp" android:bottom="8dp" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#B33E7892" />
            <stroke android:width="2dp" android:color="#E6A8EEFF" />
            <padding android:left="5dp" android:top="7dp" android:right="5dp" android:bottom="7dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#B35955A5" />
            <stroke android:width="2dp" android:color="#E6C7C2FF" />
            <padding android:left="5dp" android:top="7dp" android:right="5dp" android:bottom="7dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#A83A7088" />
            <stroke android:width="1dp" android:color="#CC73DDF7" />
            <padding android:left="6dp" android:top="8dp" android:right="6dp" android:bottom="8dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#A83A7088" />
            <stroke android:width="1dp" android:color="#CC73DDF7" />
            <padding android:left="6dp" android:top="8dp" android:right="6dp" android:bottom="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#A83A7088" />
            <stroke android:width="1dp" android:color="#CC73DDF7" />
            <padding android:left="6dp" android:top="8dp" android:right="6dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#78383C73" />
            <stroke android:width="1dp" android:color="#3D9B9FD0" />
            <padding android:left="6dp" android:top="8dp" android:right="6dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
