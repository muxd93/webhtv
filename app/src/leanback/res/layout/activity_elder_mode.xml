<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.ProgressLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/progressLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white_70"
                    android:textSize="16sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/backStandard"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_elder_action"
                android:contentDescription="@string/elder_return_standard"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/recycler"
                android:nextFocusRight="@id/search"
                android:src="@drawable/ic_elder_home"
                android:tint="@color/selector_elder_action"
                android:scaleType="fitCenter"
                android:padding="14dp" />

            <ImageButton
                android:id="@+id/search"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_elder_action"
                android:contentDescription="@string/elder_search"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/recycler"
                android:nextFocusLeft="@id/backStandard"
                android:nextFocusRight="@id/setting"
                android:src="@drawable/ic_elder_search"
                android:tint="@color/selector_elder_action"
                android:scaleType="fitCenter"
                android:padding="14dp" />

            <ImageButton
                android:id="@+id/setting"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_elder_action"
                android:contentDescription="@string/elder_mode"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/recycler"
                android:nextFocusLeft="@id/search"
                android:nextFocusRight="@id/update"
                android:src="@drawable/ic_elder_setting"
                android:tint="@color/selector_elder_action"
                android:scaleType="fitCenter"
                android:padding="14dp" />

            <ImageButton
                android:id="@+id/update"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_elder_action"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/recycler"
                android:nextFocusLeft="@id/setting"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="@color/selector_elder_action"
                android:scaleType="fitCenter"
                android:padding="14dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/white_10" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:padding="12dp" />

            <TextView
                android:id="@+id/emptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/elder_empty_hint"
                android:textColor="@color/white_70"
                android:textSize="20sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/pendingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="64dp"
                android:layout_height="64dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/elder_loading_source"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/pendingCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_elder_action"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minWidth="160dp"
                android:minHeight="56dp"
                android:text="@string/elder_cancel"
                android:textColor="@color/selector_elder_action"
                android:textSize="22sp" />

        </LinearLayout>

    </FrameLayout>

</com.fongmi.android.tv.ui.custom.ProgressLayout>
